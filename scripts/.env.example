# LiteLLM Configuration
LITELLM_HOST=http://localhost:4000
LITELLM_PASSWORD=your-litellm-password

# Proxy Configuration
PROXY_USERNAME=your-proxy-username
PROXY_PASSWORD=your-proxy-password
PROXY_HOST=proxy.example.com
PROXY_PORT=8080

# WebSearch Configuration
WEBSEARCH_REGION=pt-br
WEBSEARCH_TIMEOUT=10
WEBSEARCH_TIMELIMIT=m
WEBSEARCH_BATCH_SIZE=10
WEBSEARCH_MAX_CONCURRENCY=3
WEBSEARCH_DELAY=0.4
WEBSEARCH_MAX_RETRIES=3
WEBSEARCH_RETRY_BASE_WAIT=1
WEBSEARCH_RETRY_MAX_WAIT=32

# WebFetch Configuration
WEBFETCH_WAYBACK_TIMEOUT=30
WEBFETCH_WAYBACK_MAX_RETRIES=3
WEBFETCH_WAYBACK_RETRY_BASE_WAIT=3
WEBFETCH_WAYBACK_RETRY_MAX_WAIT=32
WEBFETCH_MIN_CONTENT_LENGTH=200
WEBFETCH_MIN_WORD_COUNT=50
WEBFETCH_VALIDITY_THRESHOLD=-1.0
